# Copy this file to .env and fill it in. Never commit .env.

# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
CLIENT_ID=

# Right-click your server / channels / roles -> Copy ID (enable Developer Mode in Discord settings first)
GUILD_ID=

# Welcome + auto-role (leave blank to turn off)
WELCOME_CHANNEL_ID=
DEFAULT_ROLE_ID=

# Moderation actions are logged here (leave blank to turn off)
MOD_LOG_CHANNEL_ID=

# Where coffee shop open/closed updates are posted
SHOP_CHANNEL_ID=
# Optional role to ping with shop updates (e.g. @Coffee Updates)
SHOP_PING_ROLE_ID=
SHOP_NAME=The Coffee Shop

# /bully: Claude-powered roasts. Leave the key blank to turn the feature off.
# Needs "Message Content Intent" enabled in the Developer Portal (Bot tab).
ANTHROPIC_API_KEY=
# Optional: comma-separated channel IDs to learn from (blank = every channel the bot can see)
BULLY_CHANNEL_IDS=
# Roles that count as staff for /intel (comma-separated role IDs; Manage Messages also counts)
STAFF_ROLE_IDS=

# HTTP API: bearer token for POST /api/shop/status (reading is public). Leave blank for read-only.
SHOP_API_TOKEN=
